{
  "name": "@tabcat/zzzync",
  "version": "6.0.0",
  "description": "sync with peers that have gone to sleep 😴",
  "type": "module",
  "sideEffects": false,
  "files": [
    "./dist/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./handler": {
      "types": "./dist/src/handler.d.ts",
      "import": "./dist/src/handler.js"
    },
    "./dialer": {
      "types": "./dist/src/dialer.d.ts",
      "import": "./dist/src/dialer.js"
    },
    "./libp2p-fetch/ipns": {
      "types": "./dist/src/libp2p-fetch/ipns.d.ts",
      "import": "./dist/src/libp2p-fetch/ipns.js"
    },
    "./challenge": {
      "types": "./dist/src/challenge.d.ts",
      "import": "./dist/src/challenge.js"
    },
    "./utils": {
      "types": "./dist/src/utils.d.ts",
      "import": "./dist/src/utils.js"
    },
    "./constants": {
      "types": "./dist/src/constants.d.ts",
      "import": "./dist/src/constants.js"
    },
    "./interface": {
      "types": "./dist/src/interface.d.ts",
      "import": "./dist/src/interface.js"
    }
  },
  "keywords": [
    "libp2p",
    "offline",
    "sync",
    "replica",
    "local-first"
  ],
  "author": "tabcat",
  "license": "MIT",
  "scripts": {
    "prepublishOnly": "pnpm install && pnpm build",
    "lint": "dprint check",
    "format": "dprint fmt",
    "build": "tsc",
    "bench": "vitest bench --config vitest.config.ts --run",
    "test": "vitest --config vitest.config.ts --run",
    "test:watch": "vitest --config vitest.config.ts",
    "api-docs": "typedoc src",
    "ci": "pnpm build && pnpm lint && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*/**": "pnpm run format"
  },
  "devDependencies": {
    "@helia/unixfs": "^7.2.1",
    "@libp2p/peer-id": "^6.0.4",
    "@types/node": "^25.0.3",
    "@types/sinon": "^21.0.0",
    "datastore-core": "^11.0.2",
    "dprint": "^0.51.1",
    "helia": "^6.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "sinon": "^21.0.0",
    "sinon-ts": "^2.0.0",
    "typedoc": "^0.28.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "@helia/car": "^5.4.0",
    "@helia/interface": "^6.2.1",
    "@ipld/car": "^5.4.2",
    "@ipld/dag-pb": "^4.1.5",
    "@libp2p/crypto": "^5.1.13",
    "@libp2p/fetch": "^4.0.12",
    "@libp2p/interface": "^3.2.0",
    "@libp2p/kad-dht": "^16.3.2",
    "@libp2p/logger": "^6.2.2",
    "@libp2p/utils": "^7.0.9",
    "@noble/curves": "^2.0.1",
    "@tabcat/helia-ipns": "^10.0.3",
    "any-signal": "^4.2.0",
    "interface-datastore": "^9.0.3",
    "interface-store": "^7.0.1",
    "ipns": "^10.1.3",
    "it-drain": "^3.0.10",
    "multiformats": "^13.4.1",
    "p-defer": "^4.0.1",
    "uint8-varint": "^2.0.4",
    "uint8arraylist": "^2.4.9",
    "uint8arrays": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "multiformats": "^13.4.1"
    },
    "onlyBuiltDependencies": [
      "dprint",
      "esbuild"
    ]
  }
}
