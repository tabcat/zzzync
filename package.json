{
  "name": "@tabcat/zzzync",
  "version": "6.0.0",
  "description": "sync with peers that have gone to sleep 😴",
  "type": "module",
  "sideEffects": false,
  "files": [
    "./dist/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./handler": {
      "types": "./dist/src/handler.d.ts",
      "import": "./dist/src/handler.js"
    },
    "./dialer": {
      "types": "./dist/src/dialer.d.ts",
      "import": "./dist/src/dialer.js"
    },
    "./challenge": {
      "types": "./dist/src/challenge.d.ts",
      "import": "./dist/src/challenge.js"
    },
    "./libp2p-fetch/ipns": {
      "types": "./dist/src/libp2p-fetch/ipns.d.ts",
      "import": "./dist/src/libp2p-fetch/ipns.js"
    },
    "./utils": {
      "types": "./dist/src/utils.d.ts",
      "import": "./dist/src/utils.js"
    },
    "./constants": {
      "types": "./dist/src/constants.d.ts",
      "import": "./dist/src/constants.js"
    },
    "./interface": {
      "types": "./dist/src/interface.d.ts",
      "import": "./dist/src/interface.js"
    }
  },
  "keywords": [
    "libp2p",
    "offline",
    "sync",
    "replica",
    "local-first"
  ],
  "author": "tabcat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabcat/zzzync.git"
  },
  "homepage": "https://tabcat.github.io/zzzync",
  "scripts": {
    "prepublishOnly": "pnpm install && pnpm build",
    "lint": "dprint check",
    "format": "dprint fmt",
    "build": "rm -rf dist && tsc",
    "bench": "vitest bench --config vitest.config.ts --run",
    "test": "vitest --config vitest.config.ts --run",
    "test:watch": "vitest --config vitest.config.ts",
    "api-docs": "typedoc",
    "ci": "pnpm build && pnpm lint && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*/**": "pnpm run format --allow-no-files"
  },
  "devDependencies": {
    "@helia/unixfs": "^8.0.5",
    "@libp2p/peer-id": "^6.0.15",
    "@types/node": "^26.3.0",
    "@types/sinon": "^22.0.0",
    "datastore-core": "^12.0.1",
    "dprint": "^0.56.1",
    "helia": "^7.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "sinon": "^22.1.0",
    "sinon-ts": "^2.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mermaid": "^1.12.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@helia/car": "^6.0.5",
    "@ipld/car": "github:tabcat/js-car#a6a133ec3f45a6c6718024b14bfabdc9f7dd56d0",
    "@ipld/dag-cbor": "^10.0.2",
    "@ipld/dag-pb": "^4.1.7",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/fetch": "^4.1.12",
    "@libp2p/interface": "^3.3.0",
    "@libp2p/kad-dht": "^16.4.4",
    "@libp2p/logger": "^6.2.13",
    "@libp2p/utils": "^7.4.0",
    "@noble/curves": "^2.3.0",
    "any-signal": "^4.2.0",
    "interface-datastore": "^10.0.1",
    "ipns": "^11.0.1",
    "multiformats": "^14.0.5",
    "progress-events": "^1.1.0",
    "uint8-varint": "^3.0.0",
    "uint8arraylist": "^3.0.2",
    "uint8arrays": "^6.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
